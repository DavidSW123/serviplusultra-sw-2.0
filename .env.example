# Turso (Base de datos en la nube)
TURSO_DATABASE_URL=libsql://tu-base.turso.io
TURSO_AUTH_TOKEN=tu_token_aqui

# Google Gemini (Escáner IA de tickets)
GEMINI_API_KEY=tu_api_key_aqui

# Google Apps Script (Relay de email para facturas)
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/TU_SCRIPT_ID/exec

# Puerto del servidor (opcional, por defecto 3000)
PORT=3000

# ─── VeriFactu / AEAT ───
NIF_EMISOR=B26892760
NOMBRE_EMISOR=ServiPlusUltra Solutions S.L.

# QR (URL del portal AEAT de validación)
# Pruebas:    https://prewww2.aeat.es/wlpl/TIKE-CONT/ValidarQR
# Producción: https://www2.agenciatributaria.gob.es/wlpl/TIKE-CONT/ValidarQR
VERIFACTU_BASE=https://prewww2.aeat.es/wlpl/TIKE-CONT/ValidarQR

# Entorno envío SOAP: pruebas | produccion
AEAT_ENV=pruebas

# Certificado digital de la empresa (.p12 / .pfx)
# Opción A — desarrollo local (ruta al fichero):
AEAT_CERT_PATH=./certs/empresa.p12
# Opción B — Render (sin filesystem persistente): contenido base64 del .p12
# Generar en Windows:  certutil -encode empresa.p12 cert.b64
# Generar en Linux:    base64 -w 0 empresa.p12 > cert.b64
AEAT_CERT_BASE64=
AEAT_CERT_PASSWORD=
