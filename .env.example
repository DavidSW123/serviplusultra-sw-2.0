# ─────────────────────────────────────────────────────────────
#  ServiPlusUltra ERP — Variables de entorno
#  Copia este archivo a .env y rellena los valores reales.
#  El servidor NO arranca si falta alguna variable OBLIGATORIA (fail-fast).
# ─────────────────────────────────────────────────────────────

# ── Base de datos Turso (OBLIGATORIO) ──
TURSO_DATABASE_URL=libsql://tu-base.turso.io
TURSO_AUTH_TOKEN=tu_token_aqui

# ── Sesión / autenticación (OBLIGATORIO) ──
# Cadena aleatoria larga para firmar los JWT de sesión.
# Generar: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ── Relay de email - Google Apps Script (OBLIGATORIO) ──
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/TU_SCRIPT_ID/exec

# ── Google Gemini - Escáner IA de tickets (opcional) ──
GEMINI_API_KEY=tu_api_key_aqui

# ── CORS / origen permitido (opcional) ──
# Por defecto: https://serviplusultra-sw-2-0.onrender.com
# En local: http://localhost:3000
APP_ORIGIN=https://serviplusultra-sw-2-0.onrender.com

# ── Puerto del servidor (opcional, por defecto 3000) ──
PORT=3000
